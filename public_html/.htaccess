Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Route API endpoints directly to api/index.php (PHP backend)
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # Block sensitive files
    <FilesMatch "\.(sqlite|db|sql|env|bak|log|ini|json|lock)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>

    # Serve static files directly if they exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other URLs to index.html
    RewriteRule ^ index.html [L]
</IfModule>
