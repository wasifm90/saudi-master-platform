APP_NAME="Saudi Master ULMA"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_VIA_ARTISAN
APP_DEBUG=false
APP_URL=https://saudimaster.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saudimas_db
DB_USERNAME=saudimas_user
DB_PASSWORD="SECURE_DB_PASSWORD"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=saudimaster.com,admin.saudimaster.com

MAIL_MAILER=smtp
MAIL_HOST=mail.saudimaster.com
MAIL_PORT=465
MAIL_USERNAME=notifications@saudimaster.com
MAIL_PASSWORD="SECURE_EMAIL_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@saudimaster.com"
MAIL_FROM_NAME="Saudi Master Notifications"
