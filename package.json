{
  "name": "saudi-master-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node node_modules/@angular/cli/bin/ng.js serve --host 127.0.0.1 --port 4306",
    "build": "node scripts/generate-seo.mjs && node node_modules/@angular/cli/bin/ng.js build",
    "build:php": "npm run build && node scripts/package-php.mjs",
    "check:api": "node node_modules/typescript/bin/tsc -p tsconfig.api.json",
    "test": "node node_modules/@angular/cli/bin/ng.js test --watch=false",
    "preview": "node scripts/serve.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/*.mjs\" angular.json \"tsconfig*.json\" package.json",
    "verify:http": "node scripts/verify-http.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "22.2.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^22.0.0",
    "ffmpeg-static": "^5.2.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.0.0",
    "node": "22.23.3",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
